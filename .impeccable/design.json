  "narrative": {
    "northStar": "The Yellow City Catalog",
    "overview": "Public Palate presents New York restaurants as a compact, photographic catalog. Taxi yellow anchors the navigation; navy Barlow lettering gives names and headings a direct, civic character. White entries sit on a cool, pale background. This is the user's approved second concept, captured in `.impeccable/mocks/city-catalog.png`.\n\nThe interface puts restaurant identity, an official health grade, and inspection dates together. Review analysis uses separate platform and star filters, with sources and collection status close at hand. Illustrative food photography supplies appetite and texture without implying that it depicts a particular restaurant.",
    "keyCharacteristics": [
      "Yellow navigation and navy typography.",
      "Compact photographic entries with distinct health-grade placards.",
      "Restaurant details expand within the catalog.",
      "Review summaries retain their sample and source context."
    ],
    "rules": [
      {
        "name": "The Official Grade Rule",
        "body": "A is blue, B is green, and C is orange. Pending and ungraded records use gray and explicit words. Keep the letter and health-grade label visible; color alone does not convey the grade.",
        "section": "colors"
      },
      {
        "name": "The Separate Ratings Rule",
        "body": "Health grades and customer stars are different facts. Present them with different shapes, labels, and context.",
        "section": "colors"
      },
      {
        "name": "The Name First Rule",
        "body": "Within an entry, the restaurant name leads, followed by cuisine and location; grade and date remain directly associated with that restaurant.",
        "section": "typography"
      },
      {
        "name": "The Border Before Shadow Rule",
        "body": "Use borders and surface color to distinguish catalog entries, expanded details, and control states.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve blue A, green B, orange C, and gray pending/ungraded states.",
      "**Do** distinguish health grades from review stars through labels and visual form.",
      "**Do** label stock food images as illustrative.",
      "**Do** retain grade dates, review-sample qualifiers, and source links near their associated content.",
      "**Do** use the shared Barlow family, surface borders, and yellow selection states.",
      "**Do** preserve keyboard focus and reduced-motion behavior."
    ],
    "donts": [
      "**Don't** use a generic green-good/red-bad scale for NYC letter grades.",
      "**Don't** depict illustrative photos as restaurant-specific evidence.",
      "**Don't** show fabricated customer reviews, star ratings, or collection success.",
      "**Don't** treat the current smallest captions as a target for future reading text."
    ]
  }
}
