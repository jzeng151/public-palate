      "css": ".ds-search{display:flex;align-items:center;gap:12px;background:var(--white,#fff);border:1px solid #cdd5e0;border-radius:8px;height:54px;padding:0 16px;color:#334868;max-width:430px}.ds-search:focus-within{border-color:var(--focus,#145bcc);box-shadow:0 0 0 1px var(--focus,#145bcc)}.ds-search input{font:400 15px Barlow,Arial,sans-serif;color:var(--ink,#101d39);border:0;outline:0;background:transparent;width:100%;min-width:0}.ds-search input::placeholder{color:#66758b;opacity:1}.ds-search svg{flex-shrink:0}"
