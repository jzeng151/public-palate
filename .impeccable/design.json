      "css": ".ds-platforms{display:flex;gap:6px;overflow:auto;border-bottom:1px solid var(--line,#dce1e8);padding-bottom:10px}.ds-platforms button{display:flex;align-items:center;justify-content:center;white-space:nowrap;min-height:34px;padding:8px 13px;border:0;border-radius:20px;background:transparent;color:var(--ink,#101d39);font:500 12px Barlow,Arial,sans-serif;cursor:pointer}.ds-platforms .ds-platform-active{background:var(--yellow,#ffdc3d);font-weight:600}.ds-platforms button:hover:not(.ds-platform-active){background:var(--background,#f7f8fa)}.ds-platforms button:focus-visible{outline:3px solid var(--focus,#145bcc);outline-offset:3px}"
