      "css": ".ds-nav{display:flex;gap:26px;align-items:center;background:var(--yellow,#ffdc3d);padding:16px 24px}.ds-nav button{position:relative;color:var(--ink,#101d39);font:600 16px Barlow,Arial,sans-serif;border:0;background:transparent;padding:8px 0;min-height:44px;cursor:pointer}.ds-nav .ds-nav-active:after{position:absolute;bottom:0;left:0;right:0;height:2px;background:var(--ink,#101d39);content:\"\"}.ds-nav button:hover{color:var(--ink,#101d39)}.ds-nav button:focus-visible{outline:3px solid var(--focus,#145bcc);outline-offset:3px}"
